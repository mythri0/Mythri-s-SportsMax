{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/reports/trigger?period=daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/reports/trigger?period=weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/reports/trigger?period=monthly",
      "schedule": "0 6 1 * *"
    }
  ]
}
