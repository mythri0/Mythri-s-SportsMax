# Jira Integration (Server-side)
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KAN

# Google Apps Script Analytics & Leads Backend
# Paste your deployed Web App /exec URL here.
# Get it from: Apps Script → Deploy → Manage Deployments → Web app URL
VITE_ANALYTICS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Admin notification (Server-side Lead Alert Recipient)
ADMIN_NOTIFICATION_EMAIL=admin@example.com
# Deprecated client-side admin fallback
VITE_ADMIN_EMAIL=admin@example.com

# Secured Report Execution Cron Secret (Server-side)
REPORT_CRON_SECRET=your-secret-cron-token-here

# Automated Reports Email Recipient (Server-side Only)
# All Daily, Weekly, and Monthly reports will be addressed to this recipient
REPORT_RECIPIENT_EMAIL=sreevarthini2006@gmail.com

# Server Email Delivery Provider (Server-side Only)
# Create a free API Key at https://resend.com/api-keys and verify your domain or use onboarding@resend.dev
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=SportsMax Reports <onboarding@resend.dev>
